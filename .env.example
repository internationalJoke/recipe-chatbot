# Copy to .env and fill in ONE provider. Never commit .env.
# Pick one provider: gemini or openrouter. Leave empty to auto-pick by which key is set.
LLM_PROVIDER=

# Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# OpenRouter (https://openrouter.ai/keys). Use a vision model so photos work.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=dots-studio/dots-3-note-preview:free

LLM_TEMPERATURE=0.7

# Optional web search tool (https://app.tavily.com). Leave empty to turn it off.
TAVILY_API_KEY=
